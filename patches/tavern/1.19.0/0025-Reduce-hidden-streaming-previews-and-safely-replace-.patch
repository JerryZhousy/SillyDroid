diff --git a/public/scripts/util/array-contents.js b/public/scripts/util/array-contents.js
new file mode 100644
index 00000000..460fd4ca
--- /dev/null
+++ b/public/scripts/util/array-contents.js
@@ -0,0 +1,20 @@
+// Inspired by TauriTavern's canonical chat replacement (without its host-specific cold-swipe handling):
+// https://github.com/Darkatse/TauriTavern/blob/edf728b67337eb45c82bbe5a13151d901cd74f4a/src/script.js#L606-L612
+
+/**
+ * Replace an array's contents without passing the whole history as function arguments.
+ * Like splice(0, length, ...source), consume the iterator before changing the
+ * target. This preserves self-replacement, dense undefined slots for holes,
+ * custom iterators, and an unchanged target when reading the source throws.
+ * @template T
+ * @param {T[]} target Existing array whose identity must remain stable
+ * @param {Iterable<T>} source Replacement values
+ * @returns {void}
+ */
+export function replaceArrayContents(target, source) {
+    const values = [...source];
+    for (let index = 0; index < values.length; index++) {
+        target[index] = values[index];
+    }
+    target.length = values.length;
+}
diff --git a/public/scripts/util/streaming-render-policy.js b/public/scripts/util/streaming-render-policy.js
new file mode 100644
index 00000000..7ace9b36
--- /dev/null
+++ b/public/scripts/util/streaming-render-policy.js
@@ -0,0 +1,33 @@
+// Adapted from TauriTavern's browser-only streaming render policy:
+// https://github.com/Darkatse/TauriTavern/blob/edf728b67337eb45c82bbe5a13151d901cd74f4a/src/scripts/tauri/perf/streaming-render-policy.js
+
+const DEFAULT_STREAMING_FPS = 30;
+const HIDDEN_MIN_INTERVAL_MS = 250;
+
+/**
+ * Normalize the configured preview FPS once before a generation starts.
+ * @param {unknown} configuredFps User-configured streaming FPS
+ * @returns {number} Finite, positive FPS
+ */
+export function normalizeStreamingFps(configuredFps) {
+    const fps = Number(configuredFps);
+    if (Number.isFinite(fps) && fps > 0) {
+        return fps;
+    }
+
+    console.warn(`Invalid streaming FPS "${String(configuredFps)}"; using the default ${DEFAULT_STREAMING_FPS} FPS.`);
+    return DEFAULT_STREAMING_FPS;
+}
+
+/**
+ * Limit expensive previews in hidden tabs without throttling network chunks,
+ * per-token events, or the final message flush.
+ * @param {object} options Render policy inputs
+ * @param {number} options.configuredFps Validated streaming FPS
+ * @param {boolean} options.hidden Whether the document is hidden
+ * @returns {number} Preview interval in milliseconds
+ */
+export function getStreamingRenderInterval({ configuredFps, hidden }) {
+    const configuredInterval = 1000 / configuredFps;
+    return hidden ? Math.max(configuredInterval, HIDDEN_MIN_INTERVAL_MS) : configuredInterval;
+}
diff --git a/tests/array-contents.node.mjs b/tests/array-contents.node.mjs
new file mode 100644
index 00000000..049bf7a1
--- /dev/null
+++ b/tests/array-contents.node.mjs
@@ -0,0 +1,63 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { replaceArrayContents } from '../public/scripts/util/array-contents.js';
+
+for (const length of [150000, 300000]) test(`replacing ${length} messages preserves the canonical array and every message reference`, () => {
+    const messages = Array.from({ length }, (_, id) => ({ mes: `Message ${id}` }));
+    const target = [{ mes: 'previous chat' }];
+    const original = target;
+    target.extensionState = 'preserved';
+    replaceArrayContents(target, messages);
+    assert.equal(target, original);
+    assert.equal(target.length, messages.length);
+    assert.ok(target.every((message, index) => message === messages[index]));
+    assert.equal(target.extensionState, 'preserved');
+    replaceArrayContents(target, [messages[7]]);
+    assert.equal(target.length, 1);
+    assert.equal(target[0], messages[7]);
+    assert.equal(Object.hasOwn(target, length - 1), false);
+    replaceArrayContents(target, []);
+    assert.equal(target.length, 0);
+});
+
+test('replacement retains spread semantics for sparse arrays, self-replacement and custom iterators', () => {
+    const item = { mes: 'Shared identity' };
+    for (const source of [[, item, , undefined], 'A😀B', new Set([item, 'second'])]) {
+        const expected = ['old'];
+        expected.splice(0, expected.length, ...source);
+        const actual = ['old'];
+        replaceArrayContents(actual, source);
+        assert.deepEqual(actual, expected);
+        assert.equal(Object.keys(actual).length, actual.length, 'Array holes become own undefined slots, as with argument spread');
+    }
+    const self = [item, 'same array'];
+    replaceArrayContents(self, self);
+    assert.deepEqual(self, [item, 'same array']);
+    assert.equal(self[0], item);
+    const custom = [item];
+    custom[Symbol.iterator] = function* () { yield 'custom first'; yield item; };
+    const actual = [];
+    replaceArrayContents(actual, custom);
+    assert.deepEqual(actual, ['custom first', item]);
+    assert.equal(actual[1], item);
+});
+
+test('invalid or failing source iteration leaves the previous chat intact', () => {
+    const previous = { mes: 'Previous chat' };
+    for (const source of [null, undefined, {}, { length: 1, 0: 'array-like' }]) {
+        const target = [previous];
+        assert.throws(() => replaceArrayContents(target, source), TypeError);
+        assert.deepEqual(target, [previous]);
+        assert.equal(target[0], previous);
+    }
+    const failure = new Error('Failed to read the next message');
+    const source = {
+        *[Symbol.iterator]() {
+            yield { mes: 'Partial replacement' };
+            throw failure;
+        },
+    };
+    const target = [previous];
+    assert.throws(() => replaceArrayContents(target, source), error => error === failure);
+    assert.deepEqual(target, [previous]);
+});
